CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7986=y
CONFIG_TARGET_mediatek_mt7986_xiaomi_redmi-router-ax6000=y
CONFIG_TARGET_mediatek_mt7986_xiaomi_redmi-router-ax6000_nand=y
CONFIG_TARGET_mediatek_mt7986_xiaomi_redmi-router-ax6000_nand_squashfs=y
CONFIG_TARGET_PROFILE_DEVICE_xiaomi_redmi-router-ax6000=y

# 基础系统
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_firewall=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_mt7986-ax6000-firmware=y
CONFIG_PACKAGE_uboot-envtools=y

# 核心插件
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y
CONFIG_PACKAGE_luci-app-wireguard=y
CONFIG_PACKAGE_luci-i18n-wireguard-zh-cn=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-i18n-lucky-zh-cn=y
CONFIG_PACKAGE_openssh-sftp-server=y

# 移除不必要的插件以节省空间
# CONFIG_PACKAGE_luci-app-adblock is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
